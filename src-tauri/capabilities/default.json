{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum local capability for the bundled VPShell main window",
  "local": true,
  "platforms": ["linux", "windows", "macOS"],
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "core:resources:allow-close",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-default-urls",
      "allow": [
        { "url": "https://*" }
      ]
    },
    "dialog:allow-open",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "allow-native-engine-probe",
    "allow-cancel-native-engine-operation",
    "allow-start-native-terminal",
    "allow-native-list-remote-files",
    "allow-ack-native-terminal-output",
    "allow-start-native-local-forward",
    "allow-list-native-local-forwards",
    "allow-stop-native-local-forward",
    "allow-start-ssh-session",
    "allow-write-terminal",
    "allow-enable-shell-integration",
    "allow-preview-broadcast",
    "allow-execute-broadcast",
    "allow-resize-terminal",
    "allow-stop-terminal",
    "allow-delete-credential",
    "allow-import-finalshell",
    "allow-initialize-app-store",
    "allow-save-app-state",
    "allow-install-wallpaper-asset",
    "allow-load-wallpaper-asset",
    "allow-install-font-asset",
    "allow-load-font-asset",
    "allow-preview-migration",
    "allow-apply-migration",
    "allow-inspect-host-key",
    "allow-trust-host-key",
    "allow-generate-ssh-key",
    "allow-install-public-key",
    "allow-list-remote-files",
    "allow-upload-remote",
    "allow-download-remote",
    "allow-get-transfer-task",
    "allow-list-transfer-tasks",
    "allow-get-transfer-recovery-status",
    "allow-retry-transfer-task",
    "allow-cancel-transfer-task",
    "allow-dismiss-transfer-task",
    "allow-preview-remote-file-operation",
    "allow-preview-remote-file-operation-recovery",
    "allow-execute-remote-file-operation",
    "allow-begin-external-edit",
    "allow-list-external-edit-recovery",
    "allow-resume-external-edit",
    "allow-discard-external-edit-recovery",
    "allow-export-external-edit-copy",
    "allow-get-external-edit-status",
    "allow-save-external-edit",
    "allow-reload-external-edit",
    "allow-end-external-edit",
    "allow-trace-route",
    "allow-download-speed-test",
    "allow-udp-speed-test",
    "allow-fetch-remote-metrics",
    "allow-start-remote-monitor",
    "allow-get-remote-monitor-snapshot",
    "allow-set-remote-monitor-paused",
    "allow-set-remote-monitor-interval",
    "allow-stop-remote-monitor"
  ]
}
