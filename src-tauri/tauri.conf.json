{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VPShell",
  "version": "0.1.0-alpha.9",
  "identifier": "com.sanro.vpshell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VPShell",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["default", "android"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data: blob:",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.1.0.1009",
        "upgradeCode": "cf78deee-d9da-56c7-a4f8-ba1440e2a166"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQzIzNEQxOEM2MjI2ODQKUldTRUptS00wVFRDN2NaR0NmdkQxVmpqTEV3MnE3WmZaZW9wQkF6ZFJpM1BXSDlnQVlWMjFLYk0K",
      "endpoints": [
        "https://github.com/sanrokamlan-prog/VPShell/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
